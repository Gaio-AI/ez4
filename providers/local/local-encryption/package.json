{
  "name": "@ez4/local-encryption",
  "description": "EZ4: Local encryption emulator",
  "version": "2.14.1",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "local",
    "emulator",
    "encryption"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/local/local-encryption"
  },
  "engines": {
    "node": ">=22.7"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    }
  },
  "workspaces": [
    "foundation/*",
    "providers/local/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873 --@ez4:registry=http://localhost:4873/",
    "clean:registry": "rm -rf ../../../.registry/@ez4/local-encryption",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@ez4/encryption": "^2.14.0",
    "@ez4/project": "^2.14.0"
  },
  "devDependencies": {
    "@ez4/aws-kms": "^2.14.0"
  }
}
