{
  "name": "@ez4/aws-agent",
  "description": "EZ4: Self-managed AWS agent provider",
  "version": "2.0.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "agent",
    "aws",
    "fargate",
    "ecr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/aws/aws-agent"
  },
  "engines": {
    "node": ">=22.7"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "require": "./dist/library.cjs",
      "import": "./dist/library.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.cjs",
      "import": "./dist/client.mjs"
    }
  },
  "sideEffects": [
    "./dist/main.cjs",
    "./dist/main.mjs",
    "./dist/library.cjs",
    "./dist/library.mjs",
    "./dist/client.cjs",
    "./dist/client.mjs"
  ],
  "workspaces": [
    "foundation/*",
    "contracts/*",
    "providers/aws/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test -e ../../../local.env",
    "test:offline": "npm run build && tsc -p tsconfig.test.json --noEmit && AWS_ENDPOINT_URL=http://127.0.0.1:9 AWS_ACCESS_KEY_ID=offline AWS_SECRET_ACCESS_KEY=offline AWS_SESSION_TOKEN= AWS_REGION=us-east-1 AWS_PROFILE= AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null ez4 test -- '!.lab.spec'",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873 --@ez4:registry=http://localhost:4873/",
    "clean:registry": "rm -rf ../../../.registry/@ez4/aws-agent",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299",
    "@aws-sdk/client-ecr": "^3.1127.0",
    "@aws-sdk/client-ecs": "^3.1151.0",
    "@aws-sdk/client-eventbridge": "^3.1151.0",
    "@aws-sdk/client-lambda": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@aws-sdk/client-servicediscovery": "^3.1151.0",
    "@aws-sdk/client-sqs": "^3.1151.0",
    "@ez4/agent": "^2.0.0",
    "@ez4/aws-common": "^2.0.0",
    "@ez4/aws-ecr": "^2.0.0",
    "@ez4/aws-ecs": "^2.0.0",
    "@ez4/aws-efs": "^2.0.0",
    "@ez4/aws-cloudmap": "^2.0.0",
    "@ez4/aws-events": "^2.0.0",
    "@ez4/aws-secret": "^2.0.0",
    "@ez4/aws-bucket": "^2.0.0",
    "@ez4/aws-function": "^2.0.0",
    "@ez4/aws-identity": "^2.0.0",
    "@ez4/aws-logs": "^2.0.0",
    "@ez4/aws-queue": "^2.0.0",
    "@ez4/aws-vpc": "^2.0.0",
    "@ez4/common": "^2.0.0",
    "@ez4/project": "^2.0.0",
    "@ez4/queue": "^2.0.0",
    "@ez4/schema": "^2.0.0",
    "@ez4/state": "^2.0.0",
    "@ez4/utils": "^2.0.0",
    "@ez4/validator": "^2.0.0"
  },
  "devDependencies": {
    "@ez4/scheduler": "^2.0.0"
  }
}
