{
  "name": "@ez4/aws-cloudfront",
  "description": "EZ4: Self-managed AWS CloudFront provider",
  "version": "1.1.1",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "cloudfront",
    "cdn",
    "aws"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/aws/aws-cloudfront"
  },
  "engines": {
    "node": ">=22.7"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.cjs",
      "import": "./dist/client.mjs"
    }
  },
  "sideEffects": [
    "./dist/main.cjs",
    "./dist/main.mjs"
  ],
  "workspaces": [
    "foundation/*",
    "contracts/*",
    "providers/aws/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test -e ../../../local.env",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873 --@ez4:registry=http://localhost:4873/",
    "clean:registry": "rm -rf ../../../.registry/@ez4/aws-cloudfront",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1127.0",
    "@ez4/aws-bucket": "^1.1.0",
    "@ez4/aws-certificate": "^1.1.0",
    "@ez4/aws-common": "^1.1.0",
    "@ez4/aws-identity": "^1.1.0",
    "@ez4/distribution": "^1.1.0",
    "@ez4/logger": "^1.1.0",
    "@ez4/project": "^1.1.0",
    "@ez4/state": "^1.1.0",
    "@ez4/utils": "^1.1.0",
    "esbuild": "^0.28.1"
  }
}
