{
  "name": "@ez4/aws-dynamodb",
  "description": "EZ4: Self-managed AWS DynamoDB provider",
  "version": "2.14.5",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "dynamodb",
    "aws"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/aws/aws-dynamodb"
  },
  "engines": {
    "node": ">=22.7"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "require": "./dist/runtime.cjs",
      "import": "./dist/runtime.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.cjs",
      "import": "./dist/client.mjs"
    }
  },
  "sideEffects": [
    "./dist/main.cjs",
    "./dist/main.mjs"
  ],
  "workspaces": [
    "foundation/*",
    "contracts/*",
    "providers/aws/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test -e ../../../local.env",
    "test:offline": "npm run build && tsc -p tsconfig.test.json --noEmit && AWS_ENDPOINT_URL=http://127.0.0.1:9 AWS_ACCESS_KEY_ID=offline AWS_SECRET_ACCESS_KEY=offline AWS_SESSION_TOKEN= AWS_REGION=us-east-1 AWS_PROFILE= AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null ez4 test -- '!.lab.spec'",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873 --@ez4:registry=http://localhost:4873/",
    "clean:registry": "rm -rf ../../../.registry/@ez4/aws-dynamodb",
    "live:publish": "npm run build && npm publish --access public"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.156"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/client-dynamodb-streams": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@ez4/aws-common": "^2.14.0",
    "@ez4/aws-function": "^2.14.0",
    "@ez4/aws-identity": "^2.14.0",
    "@ez4/aws-logs": "^2.14.0",
    "@ez4/common": "^2.14.0",
    "@ez4/database": "^2.14.0",
    "@ez4/logger": "^2.14.0",
    "@ez4/project": "^2.14.0",
    "@ez4/schema": "^2.14.0",
    "@ez4/state": "^2.14.0",
    "@ez4/transform": "^2.14.0",
    "@ez4/utils": "^2.14.0",
    "@ez4/validator": "^2.14.0"
  }
}
