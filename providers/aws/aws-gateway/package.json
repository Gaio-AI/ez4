{
  "name": "@ez4/aws-gateway",
  "description": "EZ4: Self-managed AWS API gateway provider",
  "version": "2.16.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "gateway",
    "api",
    "aws"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/aws/aws-gateway"
  },
  "engines": {
    "node": ">=22.7"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    },
    "./client/http": {
      "types": "./dist/client-http.d.ts",
      "require": "./dist/client-http.cjs",
      "import": "./dist/client-http.mjs"
    },
    "./client/ws": {
      "types": "./dist/client-ws.d.ts",
      "require": "./dist/client-ws.cjs",
      "import": "./dist/client-ws.mjs"
    }
  },
  "sideEffects": [
    "./dist/main.cjs",
    "./dist/main.mjs"
  ],
  "workspaces": [
    "foundation/*",
    "contracts/*",
    "providers/aws/*"
  ],
  "scripts": {
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test -e ../../../local.env",
    "test:offline": "npm run build && tsc -p tsconfig.test.json --noEmit && AWS_ENDPOINT_URL=http://127.0.0.1:9 AWS_ACCESS_KEY_ID=offline AWS_SECRET_ACCESS_KEY=offline AWS_SESSION_TOKEN= AWS_REGION=us-east-1 AWS_PROFILE= AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null ez4 test -- '!.lab.spec'",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873 --@ez4:registry=http://localhost:4873/",
    "clean:registry": "rm -rf ../../../.registry/@ez4/aws-gateway",
    "live:publish": "npm run build && npm publish --access public"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1127.0",
    "@aws-sdk/client-apigatewayv2": "^3.1127.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1127.0",
    "@ez4/aws-common": "^2.16.0",
    "@ez4/aws-function": "^2.16.0",
    "@ez4/aws-identity": "^2.16.0",
    "@ez4/aws-logs": "^2.16.0",
    "@ez4/common": "^2.16.0",
    "@ez4/http": "^2.16.0",
    "@ez4/gateway": "^2.16.0",
    "@ez4/logger": "^2.16.0",
    "@ez4/project": "^2.16.0",
    "@ez4/schema": "^2.16.0",
    "@ez4/state": "^2.16.0",
    "@ez4/transform": "^2.16.0",
    "@ez4/utils": "^2.16.0",
    "@ez4/validator": "^2.16.0"
  }
}
