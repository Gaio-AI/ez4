{
  "name": "aws-agent",
  "description": "Example of an agent service using AWS Fargate.",
  "version": "0.0.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.7"
  },
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "deploy": "tsc && ez4 deploy -e local.env",
    "destroy": "ez4 destroy -e local.env",
    "serve": "ez4 serve -e local.env --debug",
    "test": "ez4 test -e local.env"
  },
  "dependencies": {
    "@ez4/agent": "^2.3.0",
    "@ez4/aws-agent": "^2.3.0",
    "@ez4/aws-scheduler": "^2.3.0",
    "@ez4/common": "^2.3.0",
    "@ez4/local-agent": "^2.3.0",
    "@ez4/project": "^2.3.0",
    "@ez4/scheduler": "^2.3.0"
  }
}
