{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "foundation/**/*.ts",
      "contracts/**/*.ts",
      "libraries/**/*.ts",
      "extensions/*/src/**/*.ts",
      "providers/**/*.ts",
      "tests/database/src/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": ["foundation/**", "contracts/**", "libraries/**", "providers/**", "!foundation/reflection/test/types/class.ts"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 140,
    "expand": "auto"
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "includes": [
      "foundation/*/src/**",
      "contracts/*/src/**",
      "libraries/*/src/**",
      "extensions/*/src/**",
      "providers/*/*/src/**",
      "tests/database/src/**"
    ],
    "rules": {
      "preset": "none",
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["extensions/vscode/src/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    }
  ]
}
