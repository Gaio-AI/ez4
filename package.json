{
  "name": "@ez4/monorepo",
  "description": "EZ4 Monorepo",
  "version": "0.0.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.7"
  },
  "workspaces": [
    "foundation/utils",
    "foundation/state",
    "foundation/reflection",
    "foundation/logger",
    "foundation/project",
    "foundation/common",
    "foundation/schema",
    "foundation/validator",
    "foundation/transform",
    "libraries/http",
    "contracts/agent",
    "contracts/gateway",
    "contracts/database",
    "contracts/cache",
    "contracts/scheduler",
    "contracts/storage",
    "contracts/distribution",
    "contracts/queue",
    "contracts/topic",
    "contracts/factory",
    "contracts/validation",
    "contracts/email",
    "contracts/encryption",
    "libraries/pgsql",
    "libraries/pgclient",
    "libraries/pgmigration",
    "extensions/vscode",
    "providers/local/local-common",
    "providers/local/local-agent",
    "providers/local/local-scheduler",
    "providers/local/local-database",
    "providers/local/local-cache",
    "providers/local/local-storage",
    "providers/local/local-gateway",
    "providers/local/local-queue",
    "providers/local/local-topic",
    "providers/local/local-distribution",
    "providers/local/local-encryption",
    "providers/docs/docs-database",
    "providers/docs/docs-gateway",
    "providers/docs/docs-gateway-ui",
    "providers/docs/docs-topology",
    "providers/aws/aws-common",
    "providers/aws/aws-cloudmap",
    "providers/aws/aws-efs",
    "providers/aws/aws-secret",
    "providers/aws/aws-ecr",
    "providers/aws/aws-ecs",
    "providers/aws/aws-identity",
    "providers/aws/aws-logs",
    "providers/aws/aws-vpc",
    "providers/aws/aws-function",
    "providers/aws/aws-events",
    "providers/aws/aws-scheduler",
    "providers/aws/aws-dynamodb",
    "providers/aws/aws-aurora",
    "providers/aws/aws-valkey",
    "providers/aws/aws-kms",
    "providers/aws/aws-gateway",
    "providers/aws/aws-bucket",
    "providers/aws/aws-queue",
    "providers/aws/aws-topic",
    "providers/aws/aws-certificate",
    "providers/aws/aws-cloudfront",
    "providers/aws/aws-email",
    "providers/aws/aws-agent",
    "providers/raw/raw-pg",
    "examples/*",
    "tests/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "biome format --write",
    "lint": "biome lint --error-on-warnings && oxlint --type-aware --deny-warnings foundation/*/src contracts/*/src libraries/*/src extensions/*/src providers/*/*/src tests/database/src",
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "generate:topology": "npm run generate:topology --workspaces --if-present",
    "generate:oas": "npm run generate:oas --workspaces --if-present",
    "generate:erd": "npm run generate:erd --workspaces --if-present",
    "test:only": "npm run test:only --workspaces --if-present",
    "local:publish": "npm run local:publish --workspaces --if-present",
    "local:registry": "rm -rf .registry/* && node tools/verdaccio.mjs",
    "live:publish": "npm run build && npm run live:publish --workspaces --if-present",
    "changeset": "changeset",
    "changeset:check": "node tools/changeset-check.mjs",
    "version-packages": "npm run changeset:check && changeset version && npm install --package-lock-only --no-audit --no-fund",
    "release": "tools/release.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "^3.0.3",
    "@changesets/read": "^1.0.1",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "^7.0.2",
    "verdaccio": "^6.0.5"
  }
}
